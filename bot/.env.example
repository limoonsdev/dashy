# --- HTTP server ---------------------------------------------------------
BOT_PORT=8787
BOT_HOST=0.0.0.0

# --- Dashy API -----------------------------------------------------------
# Create a token in Dashy: Security > API tokens (abilities: read, write).
DASHY_URL=https://dashy.example.com
DASHY_API_TOKEN=

# --- Access control ------------------------------------------------------
# Comma-separated user ids. Empty means everyone can use lookup commands.
# Use "platform:id" to scope an id to one platform, e.g. discord:123.
BOT_ALLOWED_USERS=
# Users allowed to run management commands (deploy). Empty disables them.
BOT_ADMIN_USERS=

# --- Rate limit ----------------------------------------------------------
BOT_RATE_WINDOW_MS=60000
BOT_RATE_MAX=20

# --- Discord -------------------------------------------------------------
DISCORD_APPLICATION_ID=
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=

# --- Telegram ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- WhatsApp Cloud API --------------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
